{
  "name": "todo-server",
  "version": "1.0.1",
  "private": true,
  "description": "Central server for the team Gantt TODO app",
  "scripts": {
    "test:auth-import": "tsx --test tests/auth-import-regressions.test.ts",
    "test:desktop": "tsx --test tests/desktop.test.ts",
    "test:progress-timeline": "tsx --test tests/progress-timeline.test.ts",
    "test:progress-digest": "tsx --test tests/progress-digest.test.ts",
    "test:members": "tsx --test tests/member-delete.test.ts",
    "test:on-hold": "tsx --test tests/on-hold.test.ts",
    "test:todo-list": "tsx --test tests/todo-list.test.ts",
    "test:yearly": "tsx --test tests/yearly-recurrence.test.ts",
    "test:mention": "tsx --test tests/mention.test.ts",
    "test:report-reminder": "tsx --test tests/report-reminder.test.ts",
    "test:due-notifications": "tsx --test tests/due-notifications.test.ts",
    "test:backup": "tsx --test tests/backup.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test:overview": "tsx --test tests/overview.test.ts",
    "test:desktop-release": "tsx --test tests/desktop-release.test.ts",
    "import:db": "tsx src/import/cli.ts",
    "publish:desktop": "tsx scripts/publish-desktop.ts",
    "service:install": "node service/install.cjs",
    "service:uninstall": "node service/uninstall.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "node-windows": "^1.0.0-beta.8",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
