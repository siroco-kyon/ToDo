# HAKOBI チームサーバーの設定ファイルの見本。
# このファイルを同じフォルダに「.env」という名前でコピーして値を編集してください。
# シェルの環境変数で同名の値を設定した場合は、そちらが優先されます。
# パスは絶対パスで書くのがおすすめです（サービス運用時の作業フォルダ差異を避けるため）。

# サーバーの待ち受けポート（既定: 4577）
#PORT=4577

# データベースの保存先フォルダ（既定: server\data）
#TODO_DATA_DIR=C:\TodoServer\data

# 配信する Web ビルドの場所（既定: リポジトリ直下の dist-web）
#TODO_WEB_DIST=C:\TodoServer\dist-web

# 初回起動時に自動作成される管理者アカウント
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=ここに初期パスワード

# ログインの有効日数（既定: 30）
#SESSION_TTL_DAYS=30

# Cookie 名（既定: todo_session）。同じホストの別ポートでグループを分ける場合は別名にする
#SESSION_COOKIE=hakobi_group_a

# Windows サービス名（既定: TodoTeamServer、旧版との互換性のため維持）
# 独自名の場合は PORT と TODO_DATA_DIR も必ず指定する
#TODO_SERVICE_NAME=HakobiGroupA
#TODO_SERVICE_DESCRIPTION=HAKOBI Aグループ

# グループ別の設定ファイルを使う場合は、起動する PowerShell で指定する
# $env:TODO_ENV_FILE='C:\HakobiServer\groups\group-a.env'
